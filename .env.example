NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://agentlogin:local_dev_only@localhost:5432/agentlogin
DATABASE_URL_UNPOOLED=postgresql://agentlogin:local_dev_only@localhost:5432/agentlogin
LOG_LEVEL=info

# Agent API credential signing key: canonical base64url encoding of 32 random bytes.
# Keep stable across deployments. Never commit the production value.
AGENT_TOKEN_SIGNING_KEY=

# Generic OIDC provider settings. Tenant claim must be issued by your trusted IdP.
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_TENANT_CLAIM=https://agentlogin.app/tenant_id
# Maximum accepted age of a signed user access token (must align with Auth0 API token lifetime).
OIDC_MAX_TOKEN_AGE=24h

# AWS KMS envelope encryption. API uses the AWS SDK default credential chain.
AWS_REGION=
AWS_KMS_KEY_ID=

# Dedicated worker ticket key: canonical base64url encoding of 32 random bytes.
# Share this exact secret with the isolated worker; never use the agent signing key.
AGENTLOGIN_WORKER_TICKET_SIGNING_KEY=
# HTTPS worker URL, or Railway private HTTP URL ending in .railway.internal.
# Login execution routes remain disabled unless both worker settings are valid.
AGENTLOGIN_WORKER_URL=

# AgentLogin MCP service (set allowed public hostname(s) in production).
AGENTLOGIN_API_URL=http://localhost:4000
MCP_PORT=4010
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_ALLOWED_ORIGINS=

# Separate 256-bit key for signing developer application IDs and OAuth access tokens.
APPLICATION_TOKEN_SIGNING_KEY=
