NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://agentlogin_app:local_app_only@localhost:5432/agentlogin
MIGRATION_DATABASE_URL=postgresql://agentlogin_admin:local_admin_only@localhost:5432/agentlogin
AGENTLOGIN_DB_RUNTIME_ROLE=agentlogin_app
LOG_LEVEL=info
KMS_KEY_ID=
# OIDC user identity adapter. Configure with the issuer's public RSA JWKS only.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_JSON=
# Privileged, operator-only tenant bootstrap secret. Never send to agents or commit a real value.
AGENTLOGIN_BOOTSTRAP_SECRET=
# Never commit production secrets.
