NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgresql://agentlogin:local_dev_only@localhost:5432/agentlogin
DATABASE_URL_UNPOOLED=postgresql://agentlogin:local_dev_only@localhost:5432/agentlogin
LOG_LEVEL=info

# Agent API credential signing key: canonical base64url encoding of 32 random bytes.
# Keep stable across deployments. Never commit the production value.
AGENT_TOKEN_SIGNING_KEY=

# Generic OIDC provider settings. Tenant claim must be issued by your trusted IdP.
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_TENANT_CLAIM=https://agentlogin.app/tenant_id

# AWS KMS envelope encryption. API uses the AWS SDK default credential chain.
AWS_REGION=
AWS_KMS_KEY_ID=
