# Copy to apps/web/.env.local for local development.
# Keep client secrets and session secrets server-side; never commit .env.local.
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=agentlogin.us.auth0.com
AUTH0_CLIENT_ID=iiWCEKDi42gSO1HQLqBspKyj2hVugv2s
AUTH0_CLIENT_SECRET=
# Auth0 API Identifier (audience), not the Auth0 Client ID.
AUTH0_AUDIENCE=https://api.agentlogin.app
# Auth0 Organization ID for the initial AgentLogin workspace (org_...).
AUTH0_ORGANIZATION=
# Public Railway API base URL; only called from server-side code.
AGENTLOGIN_API_URL=https://agentlogin-production-90b2.up.railway.app
# Generate a unique 32-byte random value, represented as 64 hexadecimal characters.
# Example: openssl rand -hex 32
AUTH0_SECRET=
