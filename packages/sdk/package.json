{
  "name": "@agentlogin/sdk",
  "private": false,
  "version": "0.2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentlogin/contracts": "workspace:^"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zester4/agentlogin.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/zester4/agentlogin#readme",
  "bugs": {
    "url": "https://github.com/zester4/agentlogin/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Server-side TypeScript SDK for secure, scoped AgentLogin agent access.",
  "keywords": [
    "agentlogin",
    "ai-agents",
    "credential-vault",
    "agent-identity",
    "authorization",
    "typescript",
    "sdk"
  ]
}
