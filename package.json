{
  "name": "agentlogin",
  "private": true,
  "version": "0.1.0",
  "author": "Seyyid Annan",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @agentlogin/api --filter @agentlogin/web dev",
    "build": "pnpm -r build && node scripts/check-runtime-exports.mjs",
    "start": "node scripts/start-api.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @agentlogin/api --filter @agentlogin/policy --filter @agentlogin/vault --filter @agentlogin/identity --filter @agentlogin/database --filter @agentlogin/execution --filter @agentlogin/sdk --filter @agentlogin/mcp --filter @agentlogin/webhooks --filter @agentlogin/test-site test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "node scripts/check-migration-env.mjs && drizzle-kit migrate --config=drizzle.config.ts && tsx scripts/enforce-rls.ts",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts",
    "dev:mcp": "pnpm --filter @agentlogin/mcp dev",
    "start:mcp": "pnpm --filter @agentlogin/mcp start"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6"
  }
}
