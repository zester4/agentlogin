{
  "name": "agentlogin",
  "private": true,
  "version": "0.1.0",
  "author": "Seyyid Annan",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.20.0",
  "engines": { "node": ">=22.0.0", "pnpm": ">=10.0.0" },
  "scripts": {
    "dev": "pnpm --parallel --filter @agentlogin/api --filter @agentlogin/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm --filter @agentlogin/api --filter @agentlogin/policy --filter @agentlogin/vault --filter @agentlogin/identity test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
